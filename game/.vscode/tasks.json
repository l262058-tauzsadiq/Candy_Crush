
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Candy Crush",
            "type": "process",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}/main.cpp",
                "-o",
                "${workspaceFolder}/build/candy-crush.exe",
                "-I${workspaceFolder}/lib/SFML-2.6.2/include",
                "-L${workspaceFolder}/lib/SFML-2.6.2/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
