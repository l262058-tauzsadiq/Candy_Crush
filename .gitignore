
# ==========================================
# Candy Crush - Generated Build Files
# ==========================================

# Ignore generated build contents
/game/build/*

# Keep required SFML runtime DLLs
!/game/build/sfml-graphics-2.dll
!/game/build/sfml-window-2.dll
!/game/build/sfml-system-2.dll


# ==========================================
# Compiled Files
# ==========================================

# Executables
*.exe

# Object files
*.o
*.obj

# Debug and temporary compiler files
*.pdb
*.ilk
*.log
*.tmp


# ==========================================
# IDE Temporary Files
# ==========================================

# Visual Studio
.vs/

# VS Code workspace-specific files
# (Keep shared project settings in .vscode)
*.code-workspace


# ==========================================
# Windows Temporary Files
# ==========================================

Thumbs.db
Desktop.ini


# ==========================================
# Operating System Files
# ==========================================

.DS_Store
